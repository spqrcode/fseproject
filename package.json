{
  "name": "portfolio-risk-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "node --env-file-if-exists=.env.local scripts/test.mjs integration",
    "test:integration:runtime": "node --env-file-if-exists=.env.local scripts/test.mjs integration:runtime",
    "test:e2e": "node --env-file-if-exists=.env.local scripts/test.mjs e2e",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "demo:seed": "node --env-file-if-exists=.env.local scripts/demo-seed.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate:test": "node --env-file-if-exists=.env.local scripts/test.mjs migrate",
    "verify": "npm run check && npm run db:migrate:test && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "decimal.js": "10.6.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "type": "module"
}
