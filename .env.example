# Copy to .env.local and set credentials for your own local PostgreSQL instance.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/portfolio_risk
# Production must use the exact HTTPS origin of the deployed app.
APP_ORIGIN=http://localhost:3000
# Integration tests refuse database names without the suffix _test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/portfolio_risk_test
